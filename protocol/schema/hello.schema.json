{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hello.schema.json",
  "$defs": {
    "Hello": {
      "type": "object",
      "properties": {
        "collector": {
          "type": "string"
        },
        "collectorVersion": {
          "type": "string"
        },
        "gameVersion": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "collector",
        "collectorVersion",
        "gameVersion",
        "capabilities"
      ],
      "additionalProperties": true
    }
  },
  "$ref": "#/$defs/Hello"
}
